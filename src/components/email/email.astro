---
import Link from "../link/link.astro";

export interface Props {
  class?: string;
  showAddress?: boolean;
}

const { class: className, showAddress = false } = Astro.props;
---

{/* Assembled client-side so the address never appears in the HTML. */}
<Link
  href="#"
  class={className}
  x-data="email"
  data-user="charly.bernard+folio"
  data-domain="gmail.com"
  data-posthog-event="contact_initiated"
  :href="`mailto:${address}`"
>
  {showAddress ? <span x-text="label" /> : <slot />}
</Link>
