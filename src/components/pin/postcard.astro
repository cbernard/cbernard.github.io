---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

export interface Props {
  pins: { label: string; image: ImageMetadata }[];
}

const { pins = [] } = Astro.props;
---

{/* Touch only: the picture of the pin is held over the copy, like a postcard,
    for as long as the finger stays pressed. On a pointer the same picture goes
    to the panel on the left instead — see the image stack of the about page. */}
<div
  class="pointer-events-none fixed inset-0 z-40 flex items-center justify-center md:hidden"
>
  {
    pins.map((pin, index) => (
      <div
        class="absolute aspect-square w-[90vw] rotate-3 scale-95 opacity-0 transition duration-300 ease-out data-[active]:scale-100 data-[active]:opacity-100"
        :data-active={`isPressed(${index}) || null`}
      >
        <Picture
          fallbackFormat="webp"
          src={pin.image}
          formats={["webp"]}
          widths={[400, 800]}
          sizes="90vw"
          alt={pin.label}
          pictureAttributes={{ class: "block h-full w-full" }}
          class="h-full w-full object-cover object-center"
        />
      </div>
    ))
  }
</div>

{/* The pin of the pressed pair is copied in here, over the picture: the real one
    cannot rise above it, SplitText leaves a transform on the line it sits in and
    that transform is a stacking context of its own. Filled by `pin.js`. */}
<div
  class="pointer-events-none fixed inset-0 z-50 md:hidden"
  data-pin-ghosts
  aria-hidden="true"
>
</div>
