---
export interface Props {
  label: string;
  index: number;
  // Kept on the line of the pin, which it follows.
  punctuation?: string;
}

const { label = "", index = 0, punctuation = "" } = Astro.props;

const words = label.trim().split(" ");
const last = words.pop();
---

{/* `pin.js` reads `data-pin-label` to copy the pin over its picture. */}
<span
  class="transition-colors duration-200 has-[button:hover]:text-black dark:has-[button:hover]:text-white"
  data-pin-label={index}
>
  {words.length > 0 && `${words.join(" ")} `}
  <span class="whitespace-nowrap">
    {last}
    {
      /* Centred on the 0.52em x-height of TWK Lausanne, which Firefox and
        Android misread for `align-middle`. A span: Safari centres the baseline
        of an empty button. */
    }
    <span
      class:list={[
        "ms-[max(0.5rem,0.19em)]",
        punctuation ? "me-[0.08em]" : "me-[max(0.5rem,0.19em)]",
      ]}
      class="relative inline-block size-[max(1.25rem,0.46em)] align-[calc(0.26em_-_max(1.25rem,0.46em)/2)]"
      ><button
        class="absolute inset-0 cursor-pointer touch-none text-black-32 transition-colors duration-200 select-none before:absolute before:inset-0 before:rounded-full before:border before:content-[''] after:absolute after:top-1/2 after:left-1/2 after:size-[40%] after:translate-x-[-50%] after:translate-y-[-50%] after:transform after:rounded-full after:bg-current after:transition-opacity after:content-[''] hover:text-black hover:after:opacity-0 dark:text-white-32 dark:hover:text-white"
        data-pin={index}
        data-cursor="-round"
        data-cursor-stick
        aria-label="Show picture"></button></span
    >{punctuation}
  </span>
</span>
