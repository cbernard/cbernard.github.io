---
export interface Props {
  // Drawn inside the loader, white on its black, and sliding away with it.
  loader?: boolean;
}

const { loader = false } = Astro.props;

// On mobile, centred between the "CB" logo (1.4em wide) and the second column.
---

<div
  class:list={[
    "top-0 left-[calc(var(--spacing)_*_4_+_(1.4em_+_10px_+_(100vw_-_var(--spacing)_*_4_*_2_-_10px_*_5)_/_6)_/_2_-_0.5px)] h-screen w-px md:left-[calc(var(--spacing)_*_5_+_((100vw_-_10px_*_15)_/_(16_*_2)))]",
    loader
      ? "absolute bg-white-32"
      : "fixed z-[9000] bg-black-16 transition-colors duration-800 ease-[cubic-bezier(0.5,0,0,1)] dark:bg-white-16",
  ]}
>
</div>
