---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import Progress from "../../components/progress/progress.astro";
import Separator from "../../components/separator/separator.astro";
import {
  backgroundSizes,
  backgroundWidths,
  getImageByPath,
} from "../../utils/images";
import {
  aboutImage,
  aboutWidths,
  pinWidths,
  pins,
  postcardSizes,
  postcardWidths,
} from "../../utils/about";

const projects = await getCollection("projects");

const isVideo = (path: string) => /\.(mp4|webm)$/.test(path);

// The same transform as the `<Picture>` of the page, so the browser picks the
// very file it will show. A video is represented by its poster.
const getAsset = async (
  path: string | ImageMetadata,
  { widths, sizes }: { widths?: number[]; sizes?: string } = {},
) => {
  if (typeof path === "string" && isVideo(path)) {
    return { src: `/${path.replace(/\.\w+$/, ".webp")}` };
  }

  const image = await getImage({
    src: typeof path === "string" ? getImageByPath(path) : path,
    format: "webp",
    widths,
  });

  return image.srcSet.attribute
    ? { src: image.src, srcset: image.srcSet.attribute, sizes }
    : { src: image.src };
};

const background = { widths: backgroundWidths, sizes: backgroundSizes };

const projectAssets = (project: (typeof projects)[number]) => [
  getAsset(project.data.background, background),
  getAsset(project.data.thumbnail),
  ...project.data.medias.map((media) => getAsset(media)),
];

const aboutAssets = () => [
  getAsset(aboutImage, { widths: aboutWidths, sizes: backgroundSizes }),
  ...pins.flatMap((pin) =>
    pin.video
      ? [getAsset(pin.video)]
      : [
          getAsset(pin.image!, { widths: pinWidths, sizes: backgroundSizes }),
          getAsset(pin.image!, {
            widths: postcardWidths,
            sizes: postcardSizes,
          }),
        ],
  ),
];

// The loader holds the page only for what the page it opens on shows: Works
// swaps between every background and thumbnail, a project shows its own. The
// rest comes in behind it, so that the next visits are ready all the same.
// The videos themselves stream in on the page; their posters are in.
const path = Astro.url.pathname;
const landing = projects.find((project) =>
  path.startsWith(`/project/${project.data.slug}`),
);

const critical = await Promise.all(
  path === "/"
    ? projects.flatMap((project) => [
        getAsset(project.data.background, background),
        getAsset(project.data.thumbnail),
      ])
    : path.startsWith("/about")
      ? aboutAssets()
      : landing
        ? projectAssets(landing).slice(0, 4)
        : [],
);

const everything = await Promise.all([
  ...projects.flatMap(projectAssets),
  ...aboutAssets(),
]);

const unique = (images: { src: string }[]) => [
  ...new Map(images.map((image) => [JSON.stringify(image), image])).values(),
];

const held = new Set(critical.map((image) => JSON.stringify(image)));

const assets = {
  fonts: ["/fonts/TWKLausanne-300.woff2"],
  images: unique(critical),
  later: unique(everything).filter((image) => !held.has(JSON.stringify(image))),
};
---

{/* Above the separator of the page, which would otherwise darken its own. */}
<div
  class="fixed inset-0 z-[9500] grid grid-cols-6 items-center gap-[10px] bg-black px-4 text-white-32 md:px-5 md:grid-cols-16"
  x-data={`loader(${JSON.stringify(assets)})`}
>
  <Separator loader />

  {/* Nudged left so "100" stays clear of the separator. */}
  <div class="col-start-1 text-white-32 md:-translate-x-1">
    <Progress progress="load" />
  </div>

  {/* Clear of the separator, which sits close to the second column on mobile. */}
  <div class="col-span-15 col-start-2 flex items-center gap-x-4 pl-4 md:pl-0">
    <span class="text-white">Charly Bernard</span>
    <span>Frontend Developer</span>
  </div>
</div>
