---
const { index, title, link } = Astro.props;
---

<div
  class="work absolute flex h-[78px] w-full translate-y-[calc(var(--this-translate-y))] flex-col justify-center transition-all duration-1000 ease-[cubic-bezier(0.5,0,0,1)]"
  x-bind:class={`current == ${index} ? ' dark:text-white' : ' text-black-32 dark:text-white-32'`}
  x-bind:style={`getPosition(${index})`}
>
  <template x-if={`current == ${index}`}>
    <a
      href={link}
      class="grid cursor-pointer grid-cols-8 items-center gap-x-[10px] text-start text-nowrap"
    >
      <div class="col-span-1">
        {String(index + 1).padStart(2, "0")}
      </div>
      <div class="col-span-7 text-[32px] md:text-[52px]">{title}</div>
    </a>
  </template>

  <template x-if={`current != ${index}`}>
    <button
      class="grid cursor-pointer grid-cols-8 items-center gap-x-[10px] text-start text-nowrap"
      @click={`scrollTo(${index})`}
    >
      <div class="col-span-1">
        {String(index + 1).padStart(2, "0")}
      </div>
      <div class="col-span-7 text-[32px] md:text-[52px]">{title}</div>
    </button>
  </template>
</div>
