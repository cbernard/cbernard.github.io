---
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"a"> {
  href: string;
}

const { href, class: className, ...rest } = Astro.props;

const isExternal = /^https?:\/\//.test(href);
---

{
  /* The bar lives on an inner span so a padded hit area (nav links) does not
    push it away from the text. */
}
<a
  href={href}
  class:list={["group", className]}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  {...rest}
>
  <span
    class="relative inline-block after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-right after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-[cubic-bezier(0.5,0,0,1)] after:content-[''] group-hover:after:origin-left group-hover:after:scale-x-100 group-focus-visible:after:origin-left group-focus-visible:after:scale-x-100"
  >
    <slot />
  </span>
</a>
