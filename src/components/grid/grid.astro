---
export interface Props {
  iMobile: number;
  iDesktop: number;
}

const { iMobile = 0, iDesktop = 0 } = Astro.props;
---

<div
  class={`pointer-events-none fixed inset-0 z-[6000] grid grid-cols-${iMobile} grid-rows-1 gap-[10px] px-4 md:landscape:grid-cols-${iDesktop} md:landscape:px-5`}
>
  {
    Array.from({ length: iDesktop }).map((_, index) => (
      <div
        class:list={[
          "bg-[#FF0D0D] opacity-10",
          { "hidden md:landscape:block": index > iMobile },
        ]}
      />
    ))
  }
</div>
