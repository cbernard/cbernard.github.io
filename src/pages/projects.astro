---
import { type CollectionEntry, getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";
import { Picture } from "astro:assets";

import mySecondImage from "../images/tdh.jpg";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project: any) => ({
    params: { slug: project.id },
    props: project,
  }));
}

type Props = CollectionEntry<"projects">;

const project = Astro.props;
---

<Layout>
  <div class="absolute top-0 left-[60px] h-screen w-px bg-red-500"></div>
  <div class="flex h-screen w-screen flex-col overflow-hidden md:flex-row">
    <div class="relative h-[50vh] md:h-auto md:w-[50vw]">
      <div class="image absolute inset-0">
        <Picture
          src={mySecondImage}
          formats={["webp"]}
          alt="A description of my image."
          class="h-full w-full object-cover object-center"
        />
      </div>
    </div>
    <div
      class="flex h-[50vh] flex-col items-center justify-center gap-4 md:h-auto md:w-[50vw]"
    >
      Ceci est le détail

      <a href="/" class="underline">Revenir en arrière</a>
    </div>
  </div>
</Layout>
