---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

import { getImageByPath } from "../../utils/images";
import Layout from "../../layouts/Layout.astro";
import Progress from "../../components/progress/progress.astro";
import Next from "../../components/next/next.astro";
import Link from "../../components/link/link.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);

  return sortedProjects.map((project, index) => {
    const nextProject = sortedProjects[(index + 1) % sortedProjects.length];

    return {
      params: {
        name: project.data.slug,
      },
      props: {
        project: project.data,
        nextProject: nextProject.data,
        index,
      },
    };
  });
}

const { project, nextProject, index } = Astro.props;

const backgroundImage = getImageByPath(project.background);
---

<Layout>
  <div
    class="absolute end-0 top-0 z-30 m-3 mix-blend-difference landscape:fixed"
  >
    <Link href="/" class="inline-block p-2 text-white">Back</Link>
  </div>

  <div
    class="flex w-screen flex-col md:flex-row md:justify-end"
    x-data
    x-init={`$store.main.current = ${index}`}
  >
    <div
      class="panel relative md:fixed md:start-0 md:top-0 md:h-screen md:w-[50vw]"
      data-reveal-slide-up="load"
    >
      <div
        class="grid h-full grid-cols-6 grid-rows-[1fr_auto_auto] gap-x-[10px] gap-y-5 px-4 pt-5 pb-10 md:grid-cols-8 md:grid-rows-[auto_1fr_auto] md:pr-5 md:pl-5"
      >
        <div
          class="image relative col-span-6 col-start-1 row-span-2 row-start-1 -mx-4 -mt-5 aspect-[400/335] md:col-span-8 md:col-start-1 md:row-span-3 md:row-start-1 md:-mx-5 md:-mb-10 md:aspect-auto"
        >
          <Picture
            fallbackFormat="webp"
            src={backgroundImage}
            formats={["webp"]}
            widths={[400, 800]}
            sizes="(orientation: landscape) 50vw, 100vw"
            alt={`${project.title} background`}
            class="h-full w-full object-cover object-center"
          />

          {
            project.overlay > 0 && (
              <div
                class="pointer-events-none absolute inset-0 bg-black"
                style={`opacity: ${project.overlay}`}
              />
            )
          }
        </div>

        <div class="z-10 col-start-1 row-start-1 md:hidden">
          <a href="/" class="text-white">CB</a>
        </div>

        <div class="z-10 col-start-6 row-start-1 text-end md:hidden">
          <a href="/" class="text-white"> </a>
        </div>

        <div
          class="z-10 col-start-1 row-span-3 row-start-1 hidden text-white-32 md:block"
        >
          <Progress translate={true} progress="scroll" />
        </div>

        <div
          class="z-10 col-span-5 col-start-2 row-start-2 flex items-center justify-between pb-3 md:col-span-7 md:col-start-2 md:row-start-1 md:pb-0"
        >
          <div class="flex items-center gap-x-3">
            <div class="text-white">Date</div>
            <span class="text-white-32">{project.year}</span>
          </div>

          <div class="btn md:hidden">
            <div
              aria-label="Online"
              class="block aspect-square w-[5px] rounded-full bg-green"
            >
            </div>
            See live
          </div>
        </div>

        <div
          class="z-10 col-span-5 col-start-2 row-start-1 self-center text-white md:col-span-7 md:col-start-2 md:row-start-2"
        >
          {
            project.url ? (
              <a
                href={project.url}
                target="_blank"
                aria-label="See live"
                data-cursor="-pill"
                data-cursor-text="See live"
              >
                <span class="absolute inset-0 hidden md:block" />
                <h1 class="text-[32px] md:text-[52px]" data-split>
                  {project.title}
                </h1>
              </a>
            ) : (
              <h1 class="text-[52px]" data-split>
                {project.title}
              </h1>
            )
          }
        </div>

        <div
          class="z-10 col-span-5 col-start-2 row-start-3 flex flex-col gap-y-5 md:col-span-7 md:col-start-2 md:text-white lg:col-span-6 lg:col-start-2"
        >
          <div class="flex items-center gap-x-3">
            <div data-split>Services</div>
            <div
              class="text-black-32 md:text-white-32 dark:text-white-32"
              data-split
            >
              {project.services.join(", ")}
            </div>
          </div>

          <div data-split>
            {project.description}
          </div>
        </div>
      </div>
    </div>

    <div
      class="grid h-[50vh] grid-cols-6 flex-col items-center gap-[10px] px-4 pb-14 md:h-auto md:w-[50vw] md:grid-cols-8 md:pt-56 md:pr-5 md:pl-[5px]"
    >
      <div
        class="images z-2 col-span-5 col-start-2 flex flex-col gap-y-10 md:col-span-6 md:col-start-2"
        data-reveal-slide-up="load"
      >
        {
          project.medias.map((item, index) => {
            const image = getImageByPath(item);
            return (
              <div
                class="bg-black p-14 transition-colors dark:bg-white"
                data-reveal-slide-up="scroll"
                style={`--reveal-index: ${index}`}
              >
                <Picture
                  fallbackFormat="webp"
                  src={image}
                  formats={["webp"]}
                  alt={`${project.title} - ${index}`}
                  class="w-full"
                />
              </div>
            );
          })
        }
      </div>

      <div class="test z-1 col-span-full col-start-1 -mt-20">
        <Next label="Next project" href={`/project/${nextProject.slug}`} />
      </div>
    </div>
  </div>
</Layout>
