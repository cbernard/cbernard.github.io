---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

import { getImageByPath } from "../../utils/images";
import Layout from "../../layouts/Layout.astro";
import Progress from "../../components/progress/progress.astro";
import Next from "../../components/next/next.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => {
    return {
      params: {
        name: project.data.slug,
      },
      props: {
        project: project.data,
      },
    };
  });
}

const { project } = Astro.props;

const backgroundImage = getImageByPath(project.background);
---

<Layout>
  <div class="fixed end-0 top-0 z-30 m-3">
    <a href="/" class="inline-block p-2">Back</a>
  </div>

  <div class="flex w-screen flex-col md:flex-row">
    <div class="relative md:sticky md:top-0 md:h-screen md:w-[50vw]">
      <div
        class="grid h-full grid-cols-6 grid-rows-[1fr_auto_auto] gap-x-[10px] gap-y-5 px-4 pt-5 pb-10 md:grid-cols-8 md:grid-rows-[auto_1fr_auto] md:pr-5 md:pl-5"
      >
        <div
          class="image col-span-6 col-start-1 row-span-2 row-start-1 -mx-4 -mt-5 md:col-span-8 md:col-start-1 md:row-span-3 md:row-start-1 md:-mx-5 md:-mb-10"
        >
          <Picture
            src={backgroundImage}
            formats={["webp"]}
            alt="A description of my image."
            class="h-full w-full object-cover object-center"
          />
        </div>

        <div class="col-start-1 row-start-1 md:hidden">
          <a href="/" class="text-white">CB</a>
        </div>

        <div class="col-start-6 row-start-1 text-end md:hidden">
          <a href="/" class="text-white"> </a>
        </div>

        <div
          class="col-start-1 row-span-3 row-start-1 hidden text-white-32 md:block"
        >
          <Progress translate={true} progress="scroll" />
        </div>

        <div
          class="col-span-5 col-start-2 row-start-2 flex items-center justify-between pb-5 md:col-span-7 md:col-start-2 md:row-start-1 md:pb-0"
        >
          <div class="flex items-center gap-x-3">
            <div class="text-white">Date</div>
            <span class="text-white-32">{project.year}</span>
          </div>

          <div
            class="flex items-center gap-x-1 rounded-sm bg-white-16 px-2 py-1 text-white before:block before:aspect-square before:w-[5px] before:rounded-full before:bg-green md:hidden md:gap-x-2 md:p-2"
          >
            See live
          </div>
        </div>

        <div
          class="col-span-5 col-start-2 row-start-1 self-center text-white md:col-span-7 md:col-start-2 md:row-start-2"
        >
          {
            project.url ? (
              <a
                href={project.url}
                target="_blank"
                aria-label="See live"
                data-cursor-text="See live"
              >
                <span class="absolute inset-0 hidden md:block" />
                <h1 class="text-[32px] md:text-[52px]" data-split>
                  {project.title}
                </h1>
              </a>
            ) : (
              <h1 class="text-[52px]" data-split>
                {project.title}
              </h1>
            )
          }
        </div>

        <div
          class="col-span-5 col-start-2 row-start-3 flex flex-col gap-y-5 md:col-span-7 md:col-start-2 md:text-white lg:col-span-6 lg:col-start-2"
        >
          <div class="flex items-center gap-x-3">
            <div data-split>Services</div>
            <div
              class="text-black-32 md:text-white-32 dark:text-white-32"
              data-split
            >
              {project.services.join(", ")}
            </div>
          </div>

          <div data-split>
            {project.description}
          </div>
        </div>
      </div>
    </div>

    <div
      class="grid h-[50vh] grid-cols-6 flex-col items-center gap-[10px] px-4 pb-14 md:h-auto md:w-[50vw] md:grid-cols-8 md:pt-56 md:pr-5 md:pl-[5px]"
    >
      <div
        class="images z-2 col-span-5 col-start-2 flex flex-col gap-y-10 md:col-span-6 md:col-start-2"
      >
        {
          project.medias.map((item, index) => {
            const image = getImageByPath(item);
            return (
              <div class="bg-black p-14">
                <Picture
                  src={image}
                  formats={["webp"]}
                  alt={`${project.title} - ${index}`}
                  class="w-full"
                />
              </div>
            );
          })
        }
      </div>

      <div class="test z-1 col-span-full col-start-1 -mt-20">
        <Next label="Next project" />
      </div>
    </div>
  </div>
</Layout>

<script>
  console.log("coucou");
</script>
