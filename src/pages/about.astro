---
import { Picture } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Progress from "../components/progress/progress.astro";
import Pin from "../components/pin/pin.astro";
import Postcard from "../components/pin/postcard.astro";

import backgroundImage from "../images/about.jpg";
import travelImage from "../images/about_2.jpg";

// One entry per pin of the copy below, in the order they appear: the index of a
// pin is what ties its button to its picture.
const pins = [{ label: "travel lover", image: travelImage }];

const links = [
  { name: "Instagram", href: "#" },
  { name: "Linkedin", href: "#" },
];

const recognitions = [
  {
    project: "Jaeger-Lecoultre",
    award: "Awwwards",
    label: "Site of the Day",
    year: "2024",
  },
  {
    project: "Roger Dubuis",
    award: "FWA",
    label: "Site of the Day",
    year: "2024",
  },
];

const credits = [
  { name: "Thomas Monavon", role: "UX / UI Design" },
  { name: "Lausanne Agency", role: "Development" },
];

const email = "charly.bernard@gmail.com";
---

<Layout>
  <div
    class="absolute end-0 top-0 z-30 m-3 mix-blend-difference landscape:fixed"
  >
    <a href="/" class="inline-block p-2 text-white">Works</a>
  </div>

  <div
    class="flex w-screen flex-col md:flex-row md:justify-end"
    x-data="pins()"
  >
    <div
      class="relative md:fixed md:start-0 md:top-0 md:h-screen md:w-[50vw]"
      data-reveal-slide-up="load"
    >
      <div
        class="grid h-full grid-cols-6 grid-rows-[1fr_auto_auto] gap-x-[10px] gap-y-5 px-4 pt-5 pb-5 md:grid-cols-8 md:grid-rows-[auto_1fr_auto] md:pr-5 md:pl-5"
      >
        <div
          class="image relative col-span-6 col-start-1 row-span-2 row-start-1 -mx-4 -mt-5 aspect-[400/335] md:col-span-8 md:col-start-1 md:row-span-3 md:row-start-1 md:-mx-5 md:-mb-10 md:aspect-auto"
        >
          <Picture
            src={backgroundImage}
            formats={["webp"]}
            widths={[400, 800]}
            sizes="(orientation: landscape) 50vw, 100vw"
            alt="Charly"
            class="h-full w-full object-cover object-center"
          />

          {/* The pictures of the pins are stacked over the default one, which
              stays underneath: crossfading two layers instead of swapping the
              source of a single one leaves no gap between the two images. */}
          {
            pins.map((pin, index) => (
              <div
                class="absolute inset-0 opacity-0 transition-opacity duration-500 ease-out data-[active]:opacity-100"
                :data-active={`isActive(${index}) || null`}
              >
                <Picture
                  src={pin.image}
                  formats={["webp"]}
                  widths={[400, 800]}
                  sizes="(orientation: landscape) 50vw, 100vw"
                  alt={pin.label}
                  loading="eager"
                  pictureAttributes={{ class: "block h-full w-full" }}
                  class="h-full w-full object-cover object-center"
                />
              </div>
            ))
          }
        </div>

        <div class="col-start-1 row-start-1 md:hidden">
          <a href="/" class="text-white">CB</a>
        </div>

        <div class="col-start-6 row-start-1 text-end md:hidden">
          <a href="/" class="text-white"> </a>
        </div>

        <div
          class="col-start-1 row-span-3 row-start-1 hidden text-white-32 md:block"
        >
          <Progress translate={true} progress="scroll" />
        </div>

        <div
          class="col-span-5 col-start-2 row-start-2 flex items-center justify-between pb-3 md:col-span-7 md:col-start-2 md:row-start-1 md:pb-0"
        >
          <div class="flex items-center gap-x-4">
            <span class="text-white">Charly Bernard</span>
            <span class="text-white-32">Front-end Developer </span>
          </div>
        </div>

        <div
          class="col-span-5 col-start-2 row-start-3 flex flex-col gap-y-5 md:col-span-7 md:col-start-2 md:text-white lg:col-span-6 lg:col-start-2"
        >
          <div class="flex items-center gap-x-4">
            {
              links.map((link) => (
                <a href={link.href} class="hover:underline">
                  {link.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div
      class="grid min-h-[50vh] grid-cols-6 flex-col items-center gap-[10px] px-4 pb-14 md:h-auto md:w-[50vw] md:grid-cols-8 md:pt-56 md:pr-5 md:pl-[5px]"
    >
      <div
        class="z-2 col-span-5 col-start-2 transition-colors duration-200 has-[button:hover]:text-black-32 md:col-span-6 md:col-start-2 dark:has-[button:hover]:text-white-32"
      >
        {/* Split per paragraph, not on the wrapper: SplitText hoists its line
            masks as direct children of the element it splits, so a wrapper split
            would hand every line the `gap-y-4` meant to separate the paragraphs
            and the copy would lose its leading. */}
        <div
          class="flex flex-col gap-y-4 text-[clamp(2.25rem,1.58rem_+_1.39vw,3.25rem)] leading-[1.1]"
        >
          <p data-split>
            Charly Bernard is a Swiss developer and <Pin
              label={pins[0].label}
              index={0}
            />
            passionate about creating innovative and efficient digital solutions.
            With expertise in web and software development, he focuses on delivering
            high-quality, user-friendly applications.
          </p>
          <p data-split>
            Driven by curiosity and precision, between two waves Charly
            continuously explores new technologies to enhance his projects.
          </p>
          <p data-split>
            A great hiking and photography enthusiast, he is someone who loves
            to see things through in his work and has a keen eye for detail,
            ensuring pixel-perfect integration of any request.
          </p>
        </div>

        <div
          class="z-2 col-span-5 col-start-2 mt-28 flex flex-col gap-y-28 md:col-span-6 md:col-start-2 md:mt-48 md:gap-y-48"
        >
          <section
            data-reveal-slide-up="scroll"
            style="--reveal-index: 0"
            class="flex flex-col gap-y-10"
          >
            <h2 class="text-[clamp(1.5rem,1.3rem_+_0.42vw,1.875rem)]">
              Recognitions
            </h2>

            <div class="flex flex-col gap-y-5">
              {
                recognitions.map((item) => (
                  <div class="grid grid-cols-2 gap-x-[10px] gap-y-1 md:grid-cols-6">
                    <div class="col-span-2 md:col-span-2">{item.project}</div>

                    <div class="flex items-baseline gap-x-2 md:col-span-3 md:col-start-3">
                      <span class="text-black-32 dark:text-white-32">
                        {item.award}
                      </span>
                      <span>{item.label}</span>
                    </div>

                    <div class="text-end md:col-start-6">{item.year}</div>
                  </div>
                ))
              }
            </div>
          </section>

          <section
            data-reveal-slide-up="scroll"
            style="--reveal-index: 1"
            class="flex flex-col gap-y-10"
          >
            <h2 class="text-[clamp(1.5rem,1.3rem_+_0.42vw,1.875rem)]">
              Credits
            </h2>

            <div class="flex flex-col gap-y-5">
              {
                credits.map((item) => (
                  <div class="grid grid-cols-2 gap-x-[10px] gap-y-1 md:grid-cols-6">
                    <div class="md:col-span-2">{item.name}</div>

                    <div class="text-black-32 md:col-span-3 md:col-start-3 dark:text-white-32">
                      {item.role}
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <section
            data-reveal-slide-up="scroll"
            style="--reveal-index: 2"
            class="flex flex-col gap-y-5"
          >
            <h2 class="text-[clamp(1.5rem,1.3rem_+_0.42vw,1.875rem)]">
              Let&rsquo;s work together!
            </h2>

            <a href={`mailto:${email}`} class="self-start hover:underline">
              {email}
            </a>
          </section>
        </div>
      </div>
    </div>

    <Postcard pins={pins} />
  </div>
</Layout>
