---
import Layout from "../layouts/Layout.astro";
import { Picture } from "astro:assets";

import mySecondImage from "../assets/images/tdh.jpg";
---

<Layout>
    <div class="absolute top-0 left-[60px] h-screen w-px bg-red-500"></div>
    <div class="overflow-hidden w-screen h-screen flex flex-col md:flex-row">
        <div class="h-[50vh] md:w-[50vw] md:h-auto relative">
            <div class="absolute inset-0 image">
                <Picture
                    src={mySecondImage}
                    formats={["webp"]}
                    alt="A description of my image."
                    class="w-full h-full object-cover object-center"
                />
            </div>
        </div>
        <div
            class="flex flex-col gap-4 items-center justify-center h-[50vh] md:w-[50vw] md:h-auto"
        >
            Ceci est le détail

            <a href="/" class="underline">Revenir en arrière</a>
        </div>
    </div>
</Layout>
