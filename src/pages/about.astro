---
import { Picture } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Progress from "../components/progress/progress.astro";

import backgroundImage from "../images/about.jpg";

const links = [
  { name: "Instagram", href: "#" },
  { name: "Twitter", href: "#" },
];
---

<Layout>
  <div
    class="absolute end-0 top-0 z-30 m-3 mix-blend-difference landscape:fixed"
  >
    <a href="/" class="inline-block p-2 text-white">Works</a>
  </div>

  <div class="flex w-screen flex-col md:flex-row md:justify-end">
    <div
      class="relative md:fixed md:start-0 md:top-0 md:h-screen md:w-[50vw]"
      data-reveal-slide-up="load"
    >
      <div
        class="grid h-full grid-cols-6 grid-rows-[1fr_auto_auto] gap-x-[10px] gap-y-5 px-4 pt-5 pb-10 md:grid-cols-8 md:grid-rows-[auto_1fr_auto] md:pr-5 md:pl-5"
      >
        <div
          class="image col-span-6 col-start-1 row-span-2 row-start-1 -mx-4 -mt-5 aspect-[400/335] md:col-span-8 md:col-start-1 md:row-span-3 md:row-start-1 md:-mx-5 md:-mb-10 md:aspect-auto"
        >
          <Picture
            src={backgroundImage}
            formats={["webp"]}
            widths={[400, 800]}
            sizes="(orientation: landscape) 50vw, 100vw"
            alt="Charly"
            class="h-full w-full object-cover object-center"
          />
        </div>

        <div class="col-start-1 row-start-1 md:hidden">
          <a href="/" class="text-white">CB</a>
        </div>

        <div class="col-start-6 row-start-1 text-end md:hidden">
          <a href="/" class="text-white"> </a>
        </div>

        <div
          class="col-start-1 row-span-3 row-start-1 hidden text-white-32 md:block"
        >
          <Progress translate={true} progress="scroll" />
        </div>

        <div
          class="col-span-5 col-start-2 row-start-2 flex items-center justify-between pb-3 md:col-span-7 md:col-start-2 md:row-start-1 md:pb-0"
        >
          <div class="flex items-center gap-x-4">
            <span class="text-white">Charly Bernard</span>
            <span class="text-white-32"> Front-end Developer </span>
          </div>
        </div>

        <div
          class="col-span-5 col-start-2 row-start-3 flex flex-col gap-y-5 md:col-span-7 md:col-start-2 md:text-white lg:col-span-6 lg:col-start-2"
        >
          <div class="flex items-center gap-x-4">
            {
              links.map((link) => (
                <a href={link.href} class="hover:underline">
                  {link.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div
      class="grid h-[50vh] grid-cols-6 flex-col items-center gap-[10px] px-4 pb-14 md:h-auto md:w-[50vw] md:grid-cols-8 md:pt-56 md:pr-5 md:pl-[5px]"
    >
      <div
        class="z-2 col-span-5 col-start-2 transition-colors duration-200 has-[button:hover]:text-black-32 md:col-span-6 md:col-start-2 dark:has-[button:hover]:text-white-32"
      >
        <div data-split class="text-4xl">
          Mauris congue dolor at commodo sollicitudin. <div
            class="has-[button:hover]:text-black dark:has-[button:hover]:text-white"
          >
            Curabitur ac nisi
            <button
              class="relative h-5 w-10 cursor-pointer text-black-32 transition-colors duration-200 before:absolute before:top-1/2 before:left-1/2 before:h-5 before:w-5 before:translate-x-[-50%] before:translate-y-[-50%] before:rounded-full before:border before:content-[''] after:absolute after:top-1/2 after:left-1/2 after:h-2 after:w-2 after:translate-x-[-50%] after:translate-y-[-50%] after:transform after:rounded-full after:bg-current after:transition-opacity after:content-[''] hover:text-black hover:after:opacity-0 dark:text-white-32 dark:hover:text-white"
              data-cursor-stick
              aria-label="Hover me"></button>
          </div>
          dolor bibendum scelerisque eget ac ligula. Nullam vulputate pharetra mi.
          Class aptent taciti sociosqu ad litora torquent per conubia nostra, per
          inceptos himenaeos. Vivamus efficitur massa eget ligula pretium gravida.
          Pellentesque efficitur ligula at tellus dictum suscipit. Curabitur libero
          nulla, maximus et libero eu, sagittis volutpat urna. Praesent ac tincidunt
          est, sed consequat ex. Maecenas lobortis congue neque vitae placerat. Maecenas
          ac vestibulum turpis, a malesuada tellus. Curabitur sit amet euismod orci.
          Class aptent taciti sociosqu ad litora torquent per conubia nostra, per
          inceptos himenaeos. Integer eget lacinia lorem. Nam condimentum metus vel
          felis dictum, non viverra purus scelerisque.
        </div>
      </div>
    </div>
  </div>
</Layout>
