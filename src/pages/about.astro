---
import { Picture } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Progress from "../components/progress/progress.astro";
import Pin from "../components/pin/pin.astro";
import Postcard from "../components/pin/postcard.astro";
import Link from "../components/link/link.astro";
import Email from "../components/email/email.astro";
import Video from "../components/video/video.astro";

import { backgroundSizes } from "../utils/images";
import { aboutImage, aboutWidths, pinWidths, pins } from "../utils/about";

const links = [
  {
    name: "Instagram",
    handle: "@chrlbrnrd",
    href: "https://www.instagram.com/chrlbrnrd/",
  },
  {
    name: "LinkedIn",
    handle: "charlybernard",
    href: "https://www.linkedin.com/in/charlybernard/",
  },
];

const recognitions: {
  project: string;
  award: string;
  label: string;
  year: string;
}[] = [
  // {
  //   project: "Jaeger-LeCoultre",
  //   award: "Awwwards",
  //   label: "Site of the Day",
  //   year: "2024",
  // },
  // {
  //   project: "Roger Dubuis",
  //   award: "FWA",
  //   label: "Site of the Day",
  //   year: "2024",
  // },
];

const credits = [
  {
    name: "Thomas Monavon",
    role: "UX / UI Design",
    href: "https://www.thomasmonavon.com/",
  },
];
---

<Layout
  title="About"
  description="I'm a frontend developer based in Switzerland, with over 10 years of experience bringing ideas to life through clean code and thoughtful interactions."
>
  <h1 class="sr-only">About Charly Bernard</h1>

  <div
    class="absolute end-0 top-0 z-30 m-3 mix-blend-difference landscape:fixed"
    data-around-image
  >
    <Link href="/" class="inline-block p-2 text-white">Works</Link>
  </div>

  <div
    class="flex w-screen flex-col md:flex-row md:justify-end"
    x-data="pins()"
  >
    <div
      class="relative md:fixed md:start-0 md:top-0 md:h-screen md:w-[50vw]"
      data-reveal-slide-up="load"
    >
      <div
        class="grid h-full grid-cols-6 grid-rows-[1fr_auto] gap-x-[10px] gap-y-5 px-4 pt-5 pb-5 md:grid-cols-8 md:grid-rows-[auto_1fr_auto] md:pr-5 md:pl-5"
      >
        <div
          class="image relative col-span-6 col-start-1 row-span-2 row-start-1 -mx-4 -mt-5 aspect-[400/335] md:col-span-8 md:col-start-1 md:row-span-3 md:row-start-1 md:-mx-5 md:-mb-10 md:aspect-auto"
        >
          <Picture
            fallbackFormat="webp"
            src={aboutImage}
            formats={["webp"]}
            widths={aboutWidths}
            sizes={backgroundSizes}
            alt="Charly"
            class="h-full w-full object-cover object-center"
          />

          {/* The pictures of the pins are stacked over the default one, which
              stays underneath: crossfading two layers instead of swapping the
              source of a single one leaves no gap between the two images. */}
          {
            pins.map((pin, index) => (
              <div
                class="absolute inset-0 opacity-0 transition-opacity duration-500 ease-out data-[active]:opacity-100"
                data-pin-layer={index}
                :data-active={`isActive(${index}) || null`}
              >
                {pin.video ? (
                  <Video
                    path={pin.video}
                    aria-label={pin.label}
                    class="h-full w-full object-cover object-center"
                  />
                ) : (
                  <Picture
                    fallbackFormat="webp"
                    src={pin.image!}
                    formats={["webp"]}
                    widths={pinWidths}
                    sizes={backgroundSizes}
                    alt={pin.label}
                    loading="eager"
                    pictureAttributes={{ class: "block h-full w-full" }}
                    class="h-full w-full object-cover object-center"
                  />
                )}
              </div>
            ))
          }
        </div>

        {/* Positioned like the image cell above them: a positioned element
            paints over its static siblings whatever the DOM order. */}
        <div class="relative col-start-1 row-start-1 md:hidden" data-shared>
          <a href="/" class="text-white">CB</a>
        </div>

        <div class="relative col-start-6 row-start-1 text-end md:hidden">

        </div>

        <div
          class="relative col-start-1 row-span-3 row-start-1 hidden text-white-32 md:block"
        >
          <Progress translate={true} progress="scroll" />
        </div>

        <div
          class="relative col-span-5 col-start-2 row-start-2 flex items-center justify-between pb-3 md:col-span-7 md:col-start-2 md:row-start-1 md:pb-0"
        >
          <div class="flex items-center gap-x-4">
            <span class="text-white">Charly Bernard</span>
            <span class="text-white-32">Frontend Developer</span>
          </div>
        </div>

        <div
          class="relative col-span-5 col-start-2 row-start-3 hidden flex-col gap-y-5 md:flex md:col-span-7 md:col-start-2 md:text-white lg:col-span-6 lg:col-start-2"
        >
          <div class="flex items-center gap-x-4">
            {
              links.map((link) => (
                <Link
                  href={link.href}
                  data-posthog-event="social_profile_opened"
                  data-posthog-social={link.name}
                >
                  {link.name}
                </Link>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div
      class="grid min-h-[50vh] grid-cols-6 flex-col items-center gap-[10px] px-4 pb-14 md:h-auto md:w-[50vw] md:grid-cols-8 md:pt-56 md:pr-5 md:pl-[5px]"
      data-around-image
    >
      <div
        class="z-2 col-span-5 col-start-2 transition-colors duration-200 has-[button:hover]:text-black-32 md:col-span-6 md:col-start-2 dark:has-[button:hover]:text-white-32"
      >
        {/* Split per paragraph, not on the wrapper: SplitText hoists its line
            masks as direct children of the element it splits, so a wrapper split
            would hand every line the `gap-y-4` meant to separate the paragraphs
            and the copy would lose its leading. */}
        <div
          class="flex flex-col gap-y-4 text-[clamp(2rem,1.58rem_+_1.39vw,3.25rem)] leading-[1.1] text-pretty"
        >
          <p data-split>
            I’m a frontend developer based in{" "}
            <Pin label={pins[0].label} index={0} punctuation="," />{" "}
            passionate about building things for the web.
          </p>
          <p data-split>
            With over 10 years of experience, I enjoy bringing ideas to life
            through clean code and{" "}
            <Pin label={pins[1].label} index={1} punctuation="." />
          </p>
          <p data-split>
            Away from my desk, I like to keep moving: long rides on my bike,{" "}
            <Pin label={pins[2].label} index={2} />{" "}
            and early mornings spent{" "}
            <Pin label={pins[3].label} index={3} punctuation="." />
          </p>
        </div>

        <div class="mt-28 flex flex-col gap-y-28 md:mt-48 md:gap-y-48">
          {
            recognitions.length > 0 && (
              <section
                data-reveal-slide-up="scroll"
                style="--reveal-index: 0"
                class="flex flex-col gap-y-10"
              >
              <h2 class="text-[clamp(1.5rem,1.3rem_+_0.42vw,1.875rem)]">
                Recognitions
              </h2>

              <div class="flex flex-col gap-y-5">
                {
                  recognitions.map((item) => (
                    <div class="grid grid-cols-[1fr_auto] gap-x-[10px] gap-y-1 md:grid-cols-6">
                      <div class="col-span-2">{item.project}</div>

                      {/* Inline rather than a flex row: a label that wraps stays
                          in the text flow instead of hanging under the award. */}
                      <div class="md:col-span-3 md:col-start-3">
                        <span class="me-2 text-black-32 dark:text-white-32">
                          {item.award}
                        </span>
                        {item.label}
                      </div>

                      <div class="text-end md:col-start-6">{item.year}</div>
                    </div>
                  ))
                }
              </div>
              </section>
            )
          }

          <section
            data-reveal-slide-up="scroll"
            style="--reveal-index: 1"
            class="flex flex-col gap-y-10"
          >
            <h2 class="text-[clamp(1.5rem,1.3rem_+_0.42vw,1.875rem)]">
              Credits
            </h2>

            <div class="flex flex-col gap-y-5">
              {
                credits.map((item) => (
                  <div class="grid grid-cols-2 gap-x-[10px] gap-y-1 md:grid-cols-6">
                    <div class="md:col-span-2">
                      <Link href={item.href}>{item.name}</Link>
                    </div>

                    <div class="text-black-32 md:col-span-3 md:col-start-3 dark:text-white-32">
                      {item.role}
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <section
            data-reveal-slide-up="scroll"
            style="--reveal-index: 2"
            class="flex flex-col gap-y-10"
          >
            <h2 class="text-[clamp(1.5rem,1.3rem_+_0.42vw,1.875rem)]">
              Socials
            </h2>

            <div class="flex flex-col gap-y-5">
              {
                links.map((link) => (
                  <div class="grid grid-cols-2 gap-x-[10px] gap-y-1 md:grid-cols-6">
                    <div class="md:col-span-2">
                      <Link
                        href={link.href}
                        data-posthog-event="social_profile_opened"
                        data-posthog-social={link.name}
                      >
                        {link.name}
                      </Link>
                    </div>

                    <div class="text-black-32 md:col-span-3 md:col-start-3 dark:text-white-32">
                      {link.handle}
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <section
            data-reveal-slide-up="scroll"
            style="--reveal-index: 3"
            class="flex flex-col gap-y-5"
          >
            <h2 class="text-[clamp(1.5rem,1.3rem_+_0.42vw,1.875rem)]">
              Let&rsquo;s work together!
            </h2>

            <Email class="self-start" showAddress />
          </section>
        </div>
      </div>
    </div>

    <Postcard pins={pins} />
  </div>
</Layout>
