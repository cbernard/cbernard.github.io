---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Work from "../components/work/work.astro";
import Link from "../components/link/link.astro";

import { getImageByPath } from "../utils/images";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <div
    class="fixed top-0 left-0 z-30 grid w-full grid-cols-6 gap-[10px] p-4 landscape:hidden"
  >
    <span class="col-span-1 text-white">CB</span>
    <span class="col-span-4 text-white-32">Front-end Developer</span>
  </div>

  <div class="fixed end-0 top-0 z-30 m-2 landscape:m-3">
    <Link href="/about" class="inline-block p-2 text-white">About</Link>
  </div>

  <div class="fixed end-0 bottom-0 z-30">
    <Link
      href="mailto:charly.bernard@gmail.com"
      class="m-3 inline-block p-2 text-white">Contact</Link
    >
  </div>

  <div x-data="accordion()">
    <div
      class="pointer-events-none relative z-200 flex flex-col"
      x-bind:style="{ '--itemsPerViewport': visible }"
      x-ref="scrollable"
    >
      <template x-for="i in (items.length + visible)">
        <div
          class="h-[calc(150svh_/_var(--itemsPerViewport))] flex-shrink-0 landscape:h-[calc(100svh_/_var(--itemsPerViewport))]"
        >
        </div>
      </template>
    </div>

    <div
      class="fixed top-0 flex h-svh w-screen flex-col overflow-hidden landscape:flex-row"
      x-bind:style="{ '--current': current, '--length': items.length }"
      x-ref="wrapper"
      data-reveal-slide-up="load"
    >
      <div
        class="projects relative aspect-[400/335] w-full overflow-hidden landscape:order-2 landscape:aspect-auto landscape:h-auto landscape:w-[50vw]"
      >
        {
          sortedProjects.map((project, index) => {
            const backgroundImage = getImageByPath(project.data.background);
            return (
              <div
                class="absolute inset-0 z-10 opacity-0"
                x-bind:class={`current === ${index} && 'opacity-100'`}
              >
                <Picture
                  fallbackFormat="webp"
                  src={backgroundImage}
                  formats={["webp"]}
                  widths={[400, 800]}
                  sizes="(orientation: landscape) 50vw, 100vw"
                  alt={`${project.data.title} background`}
                  class="h-full w-full object-cover object-center"
                />
              </div>
            );
          })
        }

        <div
          class="projects__thumbnail absolute inset-0 z-50 hidden items-center justify-center landscape:flex"
          data-reveal-fade="swup"
        >
          <div class="aspect-[300/375] w-[300px] overflow-hidden">
            <div
              class="flex translate-y-[calc(100%_/_var(--length)_*_var(--current)_*_-1)] flex-col"
              x-bind:class={`ready && 'transition-transform'`}
            >
              {
                sortedProjects.map((project) => {
                  const thumbnailImage = getImageByPath(project.data.thumbnail);
                  return (
                    <div class="aspect-[300/375]">
                      <a href={`project/${project.data.slug}`}>
                        <Picture
                          fallbackFormat="webp"
                          src={thumbnailImage}
                          f
                          formats={["webp"]}
                          alt={`${project.data.title} thumbnail`}
                          class="w-full"
                        />
                      </a>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>

      <div
        class="relative flex flex-1 flex-col pl-5 landscape:order-1 landscape:h-auto landscape:w-[50vw]"
        x-bind:class={`ready && 'transition-transform'`}
        x-ref="container"
        data-reveal-fade="swup"
      >
        <div
          class="flex flex-col ease-[cubic-bezier(0.5,0,0,1)]"
          x-bind:class={`ready && 'transition-transform'`}
        >
          <div
            class="z-50 hidden items-center gap-x-[10px] py-5 md:grid md:grid-cols-8"
            x-ref="headline"
            x-bind:class={`{
              '-translate-y-full': current > 0,
              'transition-transform duration-1000': ready,
            }`}
          >
            <div class="col-span-1">00</div>
            <div class="col-span-7 flex items-center gap-x-4">
              <span>Charly Bernard</span>
              <span class="text-black-32 dark:text-white-32">
                Front-end Developer
              </span>
            </div>
          </div>

          {
            sortedProjects.map((project, index) => {
              return (
                <Work
                  index={index}
                  title={project.data.title}
                  link={`project/${project.data.slug}`}
                />
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
