---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Work from "../components/work/work.astro";
import Link from "../components/link/link.astro";
import Email from "../components/email/email.astro";
import Video from "../components/video/video.astro";

import {
  backgroundSizes,
  backgroundWidths,
  getImageByPath,
} from "../utils/images";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <div
    class="fixed top-0 left-0 z-30 grid w-full grid-cols-6 gap-[10px] px-4 pt-5 landscape:hidden"
  >
    <span class="col-span-1 text-white" data-shared>CB</span>
    <span class="col-span-4 text-white-32" data-around-image>
      Frontend Developer
    </span>
  </div>

  <div class="fixed end-0 top-0 z-30 mx-2 mt-3 landscape:m-3" data-around-image>
    <Link href="/about" class="inline-block p-2 text-white">About</Link>
  </div>

  {
    /* In portrait, at the bottom of the hero, whose ratio is that of `.projects`. */
  }
  <div
    class="fixed end-0 top-[calc(100vw_*_335_/_400)] z-30 -translate-y-full px-2 pb-3 landscape:top-auto landscape:bottom-0 landscape:translate-y-0 landscape:p-3"
    data-around-image
  >
    <Email class="inline-block p-2 text-white">Contact</Email>
  </div>

  <div x-data="accordion()">
    <div
      class="pointer-events-none relative z-200 flex flex-col"
      x-bind:style="{ '--itemsPerViewport': visible }"
      x-ref="scrollable"
    >
      <template x-for="i in (items.length + visible)">
        <div
          class="h-[calc(150svh_/_var(--itemsPerViewport))] flex-shrink-0 landscape:h-[calc(100svh_/_var(--itemsPerViewport))]"
        >
        </div>
      </template>
    </div>

    <div
      class="fixed top-0 flex h-svh w-screen flex-col overflow-hidden landscape:flex-row"
      x-bind:style="{ '--current': current, '--length': items.length }"
      x-ref="wrapper"
      data-reveal-slide-up="load"
    >
      <div
        class="projects relative aspect-[400/335] w-full overflow-hidden landscape:order-2 landscape:aspect-auto landscape:h-auto landscape:w-[50vw]"
      >
        {
          sortedProjects.map((project, index) => (
            <div
              class="absolute inset-0 z-10 opacity-0"
              x-bind:class={`current === ${index} && 'opacity-100'`}
            >
              {/\.(mp4|webm)$/.test(project.data.background) ? (
                <Video
                  path={project.data.background}
                  aria-hidden="true"
                  class="h-full w-full object-cover object-center"
                />
              ) : (
                <Picture
                  fallbackFormat="webp"
                  src={getImageByPath(project.data.background)}
                  formats={["webp"]}
                  widths={backgroundWidths}
                  sizes={backgroundSizes}
                  alt={`${project.data.title} background`}
                  class="h-full w-full object-cover object-center"
                />
              )}
              {/* As on the project page, so the image does not change
                  between the two. */}
              {project.data.overlay > 0 && (
                <div
                  class="pointer-events-none absolute inset-0 bg-black opacity-[min(1,calc(var(--overlay)_+_0.2))] md:opacity-(--overlay)"
                  style={`--overlay: ${project.data.overlay}`}
                />
              )}
            </div>
          ))
        }

        <div
          class="projects__thumbnail absolute inset-0 z-50 flex items-center justify-center"
          data-reveal-fade="swup"
        >
          {
            /* In portrait the hero is too short for the desktop width, so the
              thumbnail takes its size from the height. */
          }
          <div
            class="aspect-[300/375] h-[45%] overflow-hidden landscape:h-auto landscape:w-[clamp(300px,20vw,480px)]"
          >
            <div
              class="flex translate-y-[calc(100%_/_var(--length)_*_var(--current)_*_-1)] flex-col"
              x-bind:class={`ready && 'landscape:transition-transform landscape:duration-500 landscape:ease-[cubic-bezier(0.22,1,0.36,1)]'`}
            >
              {
                sortedProjects.map((project) => (
                  <div class="aspect-[300/375]">
                    <a href={`project/${project.data.slug}`}>
                      {/\.(mp4|webm)$/.test(project.data.thumbnail) ? (
                        <Video
                          path={project.data.thumbnail}
                          aria-label={`${project.data.title} thumbnail`}
                          class="w-full"
                        />
                      ) : (
                        <Picture
                          fallbackFormat="webp"
                          src={getImageByPath(project.data.thumbnail)}
                          formats={["webp"]}
                          alt={`${project.data.title} thumbnail`}
                          class="w-full"
                        />
                      )}
                    </a>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div
        class="relative flex flex-1 flex-col pl-5 landscape:order-1 landscape:h-auto landscape:w-[50vw]"
        x-bind:class={`ready && 'transition-transform'`}
        x-ref="container"
        data-reveal-fade="swup"
      >
        <div
          class="flex flex-col ease-[cubic-bezier(0.5,0,0,1)]"
          x-bind:class={`ready && 'transition-transform'`}
        >
          <div
            class="z-50 hidden items-center gap-x-[10px] py-5 md:grid md:grid-cols-8"
            x-ref="headline"
            x-bind:class={`{
              '-translate-y-full': current > 0,
              'transition-transform duration-1000': ready,
            }`}
          >
            <div class="col-span-1">00</div>
            <div class="col-span-7 flex items-center gap-x-4">
              <span>Charly Bernard</span>
              <span class="text-black-32 dark:text-white-32">
                Frontend Developer
              </span>
            </div>
          </div>

          {
            sortedProjects.map((project, index) => {
              return (
                <Work
                  index={index}
                  title={project.data.shortTitle ?? project.data.title}
                  link={`project/${project.data.slug}`}
                />
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
