---
import ThemeSwitcher from "../components/theme-switcher/theme-switcher.astro";
import Loader from "../components/loader/loader.astro";
import Grid from "../components/grid/grid.astro";
import Separator from "../components/separator/separator.astro";

import "../styles/index.css";
---

<!doctype html>
<html lang="en" x-data :class="$store.darkMode.on && 'dark'">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Charly Bernard</title>
  </head>
  <body
    class="font-primary text-black antialiased transition-colors dark:bg-black dark:text-white pointer-fine:overflow-hidden"
  >
    <Loader />

    <div
      class="fixed start-0 top-1/2 z-10 -translate-y-full md:-translate-y-0 landscape:start-[unset] landscape:end-1/2 landscape:top-0"
    >
      <ThemeSwitcher />
    </div>

    <Grid iMobile={6} iDesktop={16} />

    <div class="fixed start-0 top-0 grid w-full grid-cols-6 px-4 py-5">
      <div class="col-span-1 text-white">CB</div>
      <div class="col-span-5 text-white-32">Front-end Developer</div>
    </div>

    <Separator />

    <main id="swup">
      <slot />
    </main>

    <script>
      import gsap from "gsap";
      import Swup from "swup";
      import SwupHeadPlugin from "@swup/head-plugin";
      import SwupScriptsPlugin from "@swup/scripts-plugin";
      import SwupDebugPlugin from "@swup/debug-plugin";
      import SwupJsPlugin from "@swup/js-plugin";

      const swup = new Swup({
        plugins: [
          new SwupHeadPlugin(),
          new SwupScriptsPlugin(),
          new SwupDebugPlugin(),
          new SwupJsPlugin({
            animations: [
              {
                from: "(/)",
                to: "(/project/.*)",
                out: async () => {
                  await gsap
                    .timeline()
                    .to(".projects", {
                      xPercent: -100,
                      duration: 1,
                    })
                    .to(
                      ".projects__thumbnail",
                      { xPercent: 100, duration: 1 },
                      "<",
                    );
                },
                in: async () => {},
              },
              {
                from: "(/project/.*)",
                to: "(/)",
                out: async () => {
                  await gsap.to(".image", {
                    xPercent: 100,
                    duration: 1,
                  });
                },
                in: async () => {},
              },
            ],
          }),
        ],
      });

      const handler = () => console.log("New page loaded");
      swup.hooks.on("page:view", handler);
    </script>

    <script>
      import "../scripts/index.js";
    </script>
  </body>
</html>
