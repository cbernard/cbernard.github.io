---
import { getImage } from "astro:assets";

import ThemeSwitcher from "../components/theme-switcher/theme-switcher.astro";
import RotateNotice from "../components/rotate-notice/rotate-notice.astro";
import Loader from "../components/loader/loader.astro";
import Grid from "../components/grid/grid.astro";
import Separator from "../components/separator/separator.astro";

import "../styles/index.css";

import shareCard from "../images/share.png";

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const NAME = "Charly Bernard";

const {
  title,
  description = "Frontend developer based in Switzerland, building websites with care for detail, design systems and thoughtful interactions.",
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${NAME}` : `${NAME} — Frontend Developer`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// One card for the whole site, at the 1.91:1 every network shows, as a jpg
// they all read.
const shareImage = await getImage({
  src: shareCard,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const shareImageUrl = new URL(shareImage.src, Astro.site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: NAME,
  jobTitle: "Frontend Developer",
  url: Astro.site?.href,
  address: { "@type": "PostalAddress", addressCountry: "CH" },
  sameAs: [
    "https://www.instagram.com/chrlbrnrd/",
    "https://www.linkedin.com/in/charlybernard/",
  ],
};

// `data-loading` keeps the canvas, which Chrome on Android paints under its
// bottom bar, black for as long as the loader covers the page.
---

<!doctype html>
<html
  lang="en"
  class="data-loading:bg-black"
  data-loading
  x-data
  :class="$store.darkMode.on && 'dark'"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {
      /* TEMPORAIRE — à retirer au lancement, sans quoi le site restera
        invisible dans les résultats de recherche.

        Pas de `Disallow` dans un robots.txt en complément : il empêcherait
        les robots de lire cette balise, et une URL bloquée peut tout de même
        être listée si elle est liée depuis ailleurs. Le crawl doit rester
        ouvert pour que le `noindex` soit vu, puis respecté. */
    }
    <meta name="robots" content="noindex, nofollow" />

    {/* Kept once the line above goes: a missing page is never to be listed. */}
    {noindex && <meta name="robots" content="noindex" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(person)}
    />

    <script is:inline>
      history.scrollRestoration = "manual";
      window.scrollTo(0, 0);
    </script>
  </head>

  <body
    class="overflow-hidden bg-white font-primary text-black antialiased transition-colors dark:bg-black dark:text-white"
  >
    {
      /* Le scroll vit dans ce conteneur et non dans le document : un navigateur
        mobile ne rétracte ses barres que sur un scroll du document, et un
        viewport qui change de hauteur en plein scroll redimensionnerait
        l'accordéon sous le doigt.

        Tout est dedans, y compris les surcouches `fixed` : un geste qui part
        d'un élément resté à l'extérieur ne défilerait rien.

        `relative` pour que les éléments `absolute` sans autre ancêtre positionné
        se placent dans ce conteneur et défilent avec lui, au lieu de rester
        figés sur le viewport comme s'ils étaient `fixed`. */
    }
    <div
      id="scroller"
      class="relative h-svh overflow-x-hidden overflow-y-auto overscroll-y-contain"
    >
      <RotateNotice />

      <Loader />

      <div
        x-show="!$store.main.isLost"
        :class="$store.main.isHome ? 'fixed' : 'absolute landscape:fixed'"
        class="inset-s-0 top-[calc(100vw*335/400)] z-10 -translate-y-full landscape:inset-s-[unset] landscape:inset-e-1/2 landscape:top-0 landscape:-translate-y-0"
      >
        <ThemeSwitcher />
      </div>

      <!-- <Grid iMobile={6} iDesktop={16} /> -->

      <Separator />

      <main id="swup">
        <slot />
      </main>
    </div>

    <script>
      import "../scripts/app.js";
    </script>
  </body>
</html>
