---
import ThemeSwitcher from "../components/theme-switcher/theme-switcher.astro";
import RotateNotice from "../components/rotate-notice/rotate-notice.astro";
import Loader from "../components/loader/loader.astro";
import Grid from "../components/grid/grid.astro";
import Separator from "../components/separator/separator.astro";

import "../styles/index.css";
---

<!doctype html>
<html lang="en" x-data :class="$store.darkMode.on && 'dark'">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {
      /* TEMPORAIRE — à retirer au lancement, sans quoi le site restera
        invisible dans les résultats de recherche.

        Pas de `Disallow` dans un robots.txt en complément : il empêcherait
        les robots de lire cette balise, et une URL bloquée peut tout de même
        être listée si elle est liée depuis ailleurs. Le crawl doit rester
        ouvert pour que le `noindex` soit vu, puis respecté. */
    }
    <meta name="robots" content="noindex, nofollow" />

    <title>Charly Bernard</title>

    <script is:inline>
      history.scrollRestoration = "manual";
      window.scrollTo(0, 0);
    </script>
  </head>

  <body
    class="bg-white font-primary text-black antialiased transition-colors overflow-hidden dark:bg-black dark:text-white"
  >
    {
      /* Le scroll vit dans ce conteneur et non dans le document : un navigateur
        mobile ne rétracte ses barres que sur un scroll du document, et un
        viewport qui change de hauteur en plein scroll redimensionnerait
        l'accordéon sous le doigt.

        Tout est dedans, y compris les surcouches `fixed` : un geste qui part
        d'un élément resté à l'extérieur ne défilerait rien. */
    }
    <div
      id="scroller"
      class="h-svh overflow-x-hidden overflow-y-auto overscroll-y-contain"
    >
      <RotateNotice />

      <Loader />

      <div
        :class="$store.main.isHome ? 'fixed' : 'absolute landscape:fixed'"
        class="inset-s-0 top-[calc(100vw*335/400)] z-10 -translate-y-full landscape:inset-s-[unset] landscape:inset-e-1/2 landscape:top-0 landscape:-translate-y-0"
      >
        <ThemeSwitcher />
      </div>

      <!-- <Grid iMobile={6} iDesktop={16} /> -->

      <div class="fixed inset-s-0 top-0 grid w-full grid-cols-6 px-4 py-5">
        <div class="col-span-1 text-white">CB</div>
        <div class="col-span-5 text-white-32">Front-end Developer</div>
      </div>

      <Separator />

      <main id="swup">
        <slot />
      </main>
    </div>

    <script>
      import "../scripts/app.js";
    </script>
  </body>
</html>
