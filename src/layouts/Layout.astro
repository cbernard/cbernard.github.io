---
import { Icon } from "astro-icon/components";

import "../styles/index.css";
---

<!doctype html>
<html lang="en" x-data :class="$store.darkMode.on && 'dark'">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Charly Bernard</title>
  </head>
  <body
    class="font-primary text-black antialiased transition-colors dark:bg-black dark:text-white"
  >
    <div
      class="fixed top-0 left-[calc(var(--spacing)_*_5_+_100vw_/_32_+_5px)] z-[9999] h-screen w-px bg-black-16 dark:bg-white-16"
    >
    </div>

    <div class="fixed end-1/2 top-0 z-10">
      <button
        type="button"
        class="m-3 cursor-pointer p-2"
        x-data
        @click="$store.darkMode.toggle()"
      >
        <Icon name="switcher" class="h-3 w-3" />
      </button>
    </div>

    <div class="fixed end-0 top-0 z-30">
      <a href="#" class="m-3 inline-block p-2 text-white">Infos</a>
    </div>

    <div class="fixed end-0 bottom-0 z-30">
      <a
        href="mailto:charly.bernard@gmail.com"
        class="m-3 inline-block p-2 text-white">Contact</a
      >
    </div>

    <main id="swup">
      <slot />
    </main>

    <script>
      import gsap from "gsap";
      import Swup from "swup";
      import SwupHeadPlugin from "@swup/head-plugin";
      import SwupScriptsPlugin from "@swup/scripts-plugin";
      import SwupDebugPlugin from "@swup/debug-plugin";
      import SwupJsPlugin from "@swup/js-plugin";

      const swup = new Swup({
        plugins: [
          new SwupHeadPlugin(),
          new SwupScriptsPlugin(),
          new SwupDebugPlugin(),
          new SwupJsPlugin({
            animations: [
              {
                from: "(/)",
                to: "(/project/.*)",
                out: async () => {
                  await gsap
                    .timeline()
                    .to(".projects", {
                      xPercent: -100,
                      duration: 1,
                    })
                    .to(
                      ".projects__thumbnail",
                      { xPercent: 100, duration: 1 },
                      "<",
                    );
                },
                in: async () => {},
              },
              {
                from: "(/project/.*)",
                to: "(/)",
                out: async () => {
                  await gsap.to(".image", {
                    xPercent: 100,
                    duration: 1,
                  });
                },
                in: async () => {},
              },
            ],
          }),
        ],
      });

      const handler = () => console.log("New page loaded");
      // Register a handler
      swup.hooks.on("page:view", handler);
    </script>

    <script>
      import "../scripts/index.js";
    </script>
  </body>
</html>
